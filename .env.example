# Your dzbot server: the subdomain of its page (your-server for your-server.dzbot.de)
DZBOT_SERVER=your-server

# Admin area → Developers → your app → Keys. Give the key the rights the bot needs, e.g. admin.players.view.
DZBOT_API_KEY=dzk_your_key_here

# Admin area → Developers → your app → Webhooks: endpoint https://<your host>/webhooks/dzbot, event log.player_kill
DZBOT_WEBHOOK_SECRET=

# Admin area → Developers → your app → Sign in with dzbot: add http://localhost:3000/auth/callback as redirect URI
DZBOT_CLIENT_ID=
DZBOT_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3000

# https://discord.com/developers/applications → your application
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
# The channel the kill feed goes to
DISCORD_KILLFEED_CHANNEL_ID=

PORT=3000
